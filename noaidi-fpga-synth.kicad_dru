#
# JLCPCB's limits are the authority on the design rules
# (https://jlcpcb.com/capabilities/pcb-capabilities). The board setup holds
# the figures that apply to every object. The rules here hold the limits the
# fab states for component holes, which are wider than its limits for vias,
# on every layer and on the inner layers.

(rule "annular ring of a component hole"
	(constraint annular_width (min 0.18mm))
	(condition "A.Type == 'Pad'"))

(rule "component hole to component hole"
	(constraint hole_to_hole (min 0.45mm))
	(condition "A.Type == 'Pad' && B.Type == 'Pad'"))

(rule "track to a component hole"
	(constraint hole_clearance (min 0.28mm))
	(condition "A.Type == 'Pad' && B.Type == 'Track'"))

(rule "inner copper to a component hole"
	(layer inner)
	(constraint hole_clearance (min 0.3mm))
	(condition "A.Type == 'Pad'"))

# A differential pair is laid as a pair (scripts/lay_pairs.py). Its two
# tracks part only to reach their pads: on this board the USB data pair's
# tracks part for 5.9 mm, to the ESP32 module's pins, which are 2.54 mm
# apart, and in the branches to the socket's second pads. Routed as two
# unrelated tracks, the whole of a net counts as parted.

(rule "the two tracks of a pair run side by side"
	(constraint diff_pair_uncoupled (max 10mm))
	(condition "A.inDiffPair('*')"))

# 150 mil, the most that Microchip's High Speed USB Design Guidelines
# (application note 7633, 2.4) allow the two lines of a USB pair to differ
# by. KiCad's length of a net includes its branches.

(rule "the two tracks of a pair are equally long"
	(constraint skew (max 3.81mm))
	(condition "A.inDiffPair('*')"))

# What an antenna's maker wants kept away from it stays out of the areas
# named "Antenna clearance", which scripts/board_from_circuit.py draws around
# each antenna of circuit/antennas.toml. The areas close nothing by
# themselves: copper is laid and filled in them. The net classes named here
# are that file's.

(rule "kept away from an antenna"
	(constraint disallow track via pad)
	(condition "A.NetClass == 'USB' && A.intersectsArea('Antenna clearance')"))
